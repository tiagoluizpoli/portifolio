---
import { contentStore } from '../lib/content/instance';
import { ContentError } from '../lib/content/store';
import { type SectionKey, sectionSchemas } from '../lib/content/schemas';
import { bringFromProduction, sendToProduction } from '../lib/sync';
import { uploadAsset } from '../lib/upload';

// Development-only; Tailscale is the guard, there is no login.
if (process.env.ADMIN_ENABLED !== 'true') return new Response(null, { status: 404 });

const errorMessage = (value: unknown) => (value instanceof Error ? value.message : String(value));
const keys = Object.keys(sectionSchemas) as SectionKey[];
let error: string | undefined;
let uploaded: string | undefined;
let saved: string | undefined;
let synced: string | undefined;
const drafts: Partial<Record<SectionKey, string>> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const file = form.get('file');
    const sync = form.get('sync'); // narrowed to a SyncDirection by the checks below
    if (sync === 'send') {
      synced = await sendToProduction(contentStore);
    } else if (sync === 'bring') {
      synced = await bringFromProduction(contentStore);
    } else if (file instanceof File) {
      uploaded = await uploadAsset(new Uint8Array(await file.arrayBuffer()), file.name);
    } else {
      const section = String(form.get('section'));
      const key = keys.find((candidate) => candidate === section);
      if (!key) throw new Error(`unknown section ${section}`);
      const json = String(form.get('json'));
      drafts[key] = json;
      let data: unknown;
      try {
        data = JSON.parse(json);
      } catch (parseError) {
        throw new ContentError(key, `invalid JSON (${errorMessage(parseError)})`);
      }
      await contentStore.saveSection(key, data);
      delete drafts[key];
      saved = key;
    }
  } catch (caught) {
    error = errorMessage(caught);
  }
}

const content = contentStore.read();
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Admin</title><meta name="robots" content="noindex" /></head>
  <body style="font-family: monospace; max-width: 60rem; margin: 2rem auto; padding: 0 1rem">
    <h1>Admin</h1>
    {error && <p role="alert" style="color: #b00">{error}</p>}
    {saved && <p>Saved <b>{saved}</b>.</p>}
    {synced && <p>{synced}</p>}
    <h2>Sync</h2>
    <form method="post">
      <button name="sync" value="send">Send to production</button>
      <button name="sync" value="bring">Bring from production</button>
    </form>
    <h2>Upload asset</h2>
    <form method="post" enctype="multipart/form-data">
      <input type="file" name="file" required /> <button>Upload</button>
    </form>
    {uploaded && <p>Path: <code>{uploaded}</code></p>}
    {keys.map((key) => (
      <form method="post">
        <h2>{key}</h2>
        <input type="hidden" name="section" value={key} />
        <textarea name="json" rows="14" style="width: 100%">{drafts[key] ?? JSON.stringify(content[key], null, 2)}</textarea>
        <button>Save {key}</button>
      </form>
    ))}
  </body>
</html>
