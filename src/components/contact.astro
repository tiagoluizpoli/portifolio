---
import { assetUrl } from '../lib/assets';
import { contentStore } from '../lib/content/instance';
import { type Locale, ui } from '../lib/locale';

const { lang } = Astro.props as { lang: Locale };
const { contact, hero } = contentStore.read();
const t = ui[lang];
/** Last path segment of a profile URL: the handle shown next to LinkedIn and GitHub. */
const handle = (url: string) => new URL(url).pathname.split('/').filter(Boolean).at(-1) ?? '';
const year = new Date().getFullYear();

interface Way {
  label: string;
  hint?: string;
  href: string;
  event?: string;
  download?: boolean;
}
const ways: Way[] = [
  ...(contact.whatsappUrl ? [{ label: 'WhatsApp', href: contact.whatsappUrl, event: 'whatsapp-click' }] : []),
  { label: 'LinkedIn', hint: handle(contact.linkedinUrl), href: contact.linkedinUrl },
  ...(contact.email ? [{ label: 'Email', hint: contact.email, href: `mailto:${contact.email}` }] : []),
  { label: 'GitHub', hint: handle(contact.githubUrl), href: contact.githubUrl },
  ...(contact.cv ? [{ label: t.downloadCv, hint: 'PDF', href: assetUrl(contact.cv[lang]), event: 'cv-download', download: true }] : []),
];
---
<footer class="contact" id="contact" aria-labelledby="contact-h">
  <div class="field">
    <h2 class="sec-h" id="contact-h">{t.nav.contact}</h2>
    <ul class="ways">
      {ways.map((w) => (
        <li>
          <a href={w.href} download={w.download} data-umami-event={w.event} data-umami-event-locale={w.event && lang}>
            <span class="label">{w.label}</span>
            {w.hint && <span class="hint">{w.hint}</span>}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
    <p class="foot"><span>© {year} {hero.name}</span><span>{hero.location[lang]}</span></p>
  </div>
</footer>

<style>
  .contact {
    padding: clamp(96px, 14vh, 170px) 10px 10px;
  }
  .field {
    --gut: clamp(16px, 3.5vw, 56px);
    padding: clamp(40px, 6vw, 96px) var(--gut) 26px;
    border-radius: var(--radius-field);
    background: var(--color-field);
  }
  .ways {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ways li {
    border-top: 1.5px solid var(--color-line);
  }
  .ways li:last-child {
    border-bottom: 1.5px solid var(--color-line);
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 24px;
    padding: 18px 8px;
    color: inherit;
    text-decoration: none;
  }
  .label {
    font-weight: 800;
    font-size: clamp(1.9rem, 4.2vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-stretch: 85%;
    font-variation-settings: "opsz" 72;
    transition: translate 0.5s var(--ease-out-expo);
  }
  .hint {
    overflow-wrap: anywhere;
    color: var(--color-ink-2);
    font-size: 15px;
    font-weight: 500;
  }
  svg {
    grid-column: 3;
    width: 34px;
    height: 34px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.5s var(--ease-out-expo), color 0.2s;
  }
  a:hover .label {
    translate: 14px 0;
  }
  a:hover svg {
    translate: 6px 0;
    color: var(--color-accent);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin: clamp(48px, 7vw, 96px) 0 0;
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .contact {
      padding-inline: 8px;
      padding-bottom: 8px;
    }
    .field {
      border-radius: 28px;
    }
    a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
    }
    .hint {
      grid-row: 2;
      font-size: 14px;
    }
    svg {
      grid-column: 2;
      grid-row: 1 / span 2;
      width: 26px;
      height: 26px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .label,
    svg {
      transition: none;
    }
  }
</style>
