---
import { assetUrl } from '../lib/assets';
import { contentStore } from '../lib/content/instance';
import { type Locale, ui } from '../lib/locale';

const { lang } = Astro.props as { lang: Locale };
const { projects } = contentStore.read().showcase;
const t = ui[lang];
---
<section id="projects">
  <h2 class="text-2xl font-bold">{t.nav.projects}</h2>
  {projects.map((p) => (
    <article class="mt-6">
      <h3 class="text-xl font-semibold">{p.name}</h3>
      <p>{t.status[p.status]}</p>
      <p class="mt-2">{p.summary[lang]}</p>
      <p class="mt-2">{t.roleLabel}: {p.role[lang]}</p>
      <ul class="mt-2 flex flex-wrap gap-2">{p.stack.map((tag) => <li>{tag}</li>)}</ul>
      {p.now && <p class="mt-2">{t.now} {p.now[lang]}</p>}
      {p.images.map((img) => <img class="mt-2" src={assetUrl(img.path)} alt={img.alt[lang]} loading="lazy" />)}
      {p.learnMoreUrl && <a class="underline" href={p.learnMoreUrl}>{t.learnMore}</a>}
    </article>
  ))}
</section>
