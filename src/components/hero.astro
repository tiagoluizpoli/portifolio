---
import { contentStore } from '../lib/content/instance';
import { assetUrl } from '../lib/assets';
import { type Locale, ui } from '../lib/locale';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { hero } = contentStore.read();
const labels = ui[lang];
const stats = contentStore.stats();
const statsLine = stats
  ? labels.stats
      .replace('{contributions}', stats.contributions.toLocaleString(lang))
      .replace('{repos}', stats.publicRepos.toLocaleString(lang))
      .replace('{languages}', new Intl.ListFormat(lang, { type: 'conjunction' }).format(stats.languages))
  : undefined;
---
<header>
  <h1 class="text-4xl font-bold">{hero.name}</h1>
  <p class="text-xl">{hero.title[lang]}</p>
  <p class="mt-4 max-w-2xl">{hero.pitch[lang]}</p>
  <p class="mt-2 text-sm">{hero.location[lang]}</p>
  {statsLine && <p class="mt-2 text-sm">{statsLine}</p>}
  <p class="mt-4 flex gap-4">
    {hero.whatsappUrl && <a class="underline" href={hero.whatsappUrl} data-umami-event="whatsapp-click" data-umami-event-locale={lang}>{labels.whatsapp}</a>}
    {hero.cv && <a class="underline" href={assetUrl(hero.cv[lang])} data-umami-event="cv-download" data-umami-event-locale={lang}>{labels.downloadCv}</a>}
  </p>
</header>
