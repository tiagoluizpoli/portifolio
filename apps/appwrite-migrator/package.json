{
  "name": "appwrite-migrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "start": "node dist/index.js",
