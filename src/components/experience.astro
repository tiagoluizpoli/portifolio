---
import { contentStore } from '../lib/content/instance';
import { type Locale, ui } from '../lib/locale';

const { lang } = Astro.props as { lang: Locale };
const { roles } = contentStore.read().experience;
const t = ui[lang];
const month = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const fmt = (ym: string) => month.format(new Date(`${ym}-01T00:00:00Z`));
---
<section id="experience">
  <h2 class="text-2xl font-bold">{t.nav.experience}</h2>
  {roles.map((r) => (
    <article class="mt-6">
      <h3 class="text-xl font-semibold">{r.title[lang]} · {r.company}{r.kind && ` · ${r.kind[lang]}`}</h3>
      <p>{fmt(r.start)} – {r.end ? fmt(r.end) : t.present} · {r.location[lang]}</p>
      <ul class="mt-2 list-disc pl-5">{r.highlights.map((h) => <li>{h[lang]}</li>)}</ul>
    </article>
  ))}
</section>
